{
  "version": 2,
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "cd frontend && VITE_API_URL= npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/ai/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|ai/).*)", "destination": "/index.html" }
  ]
}
